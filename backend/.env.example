# Skopiuj do backend/.env (jest w .gitignore, nie trafia do obrazu Dockera). docker compose wczytuje go do kontenera
# backendu, ale DATABASE_URL, ADMIN_TOKEN i SESSION_SECRET ustawia tam sam compose. Lokalnie: uvicorn ... --env-file .env
CORS_ORIGINS=http://localhost:3000
# Opcjonalnie: bezwzględna ścieżka katalogu kart poza repozytorium.
# CARDS_DATA_PATH=/absolute/path/to/cards.json
# Token panelu administracyjnego (nagłówek Authorization: Bearer ...). Bez niego /api/v1/admin/* zwraca 401.
# ADMIN_TOKEN=dev
# Klucz podpisu tokenów symulowanego logowania mObywatel. Bez niego losowy przy każdym starcie (wylogowuje po restarcie).
# SESSION_SECRET=zmien-mnie
# PostgreSQL (wersje parametrów, gry, wnioski). Domyślnie baza z `docker compose up -d db`.
# DATABASE_URL=postgresql://otwartekarty:otwartekarty@localhost:5432/otwartekarty
# Testy integracyjne (pytest -m integration) działają w osobnym schemacie otwartekarty_test tej bazy.
# TEST_DATABASE_URL=postgresql://otwartekarty:otwartekarty@localhost:5432/otwartekarty
# Odczyt wgranych skanów spraw (/cases/parse) modelem AI (app/llm.py). Bez dostawcy tylko wpisywanie ręczne.
# Darmowe poziomy usług w chmurze mogą używać danych do trenowania: do prawdziwych dokumentów płatny klucz albo model lokalny.
# LLM_PROVIDER=gemini            # gemini | openai; sam GEMINI_API_KEY wybiera gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-4-hydrogen
# Dowolne API zgodne z OpenAI (model musi czytać obrazy), np.:
#   lokalnie (Ollama, vLLM, LM Studio; open-weight, np. Qwen-VL, Gemma, Pixtral): LLM_BASE_URL=http://host.docker.internal:11434/v1
#   Mistral (UE): LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5vl
# LLM_API_KEY=...                # gdy serwer go wymaga
