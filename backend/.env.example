# Zmienne należy wyeksportować w terminalu; plik nie jest ładowany automatycznie.
CORS_ORIGINS=http://localhost:3000
# Opcjonalnie: bezwzględna ścieżka katalogu kart poza repozytorium.
# CARDS_DATA_PATH=/absolute/path/to/cards.json
# Token panelu administracyjnego (nagłówek Authorization: Bearer ...). Bez niego /api/v1/admin/* zwraca 401.
# ADMIN_TOKEN=dev
# PostgreSQL (wersje parametrów, gry, wnioski). Domyślnie baza z `docker compose up -d db`.
# DATABASE_URL=postgresql://zp:zp@localhost:5432/zp
# Testy integracyjne (pytest -m integration) działają w osobnym schemacie zp_test tej bazy.
# TEST_DATABASE_URL=postgresql://zp:zp@localhost:5432/zp
